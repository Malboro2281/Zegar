<Window x:Class="Zegar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zegar" Height="250" Width="450"
        Background="Navy" Foreground="White">

    <!-- DODATKOWE ZADANIE: Stylista -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock x:Name="GodzinaText"
                   Grid.Row="0"
                   FontSize="35"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <TextBlock x:Name="DataText"
                   Grid.Row="1"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <TextBlock x:Name="TydzienText"
                   Grid.Row="2"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        
    </Grid>
</Window>